{
	"nodes":[
		{"id":"lane8","type":"group","label":"Notification delivery","x":-30,"y":3215,"width":1800,"height":355},
		{"id":"lane7","type":"group","label":"Profile update","x":-30,"y":2805,"width":1800,"height":355},
		{"id":"lane6","type":"group","label":"Payment and commission","x":-30,"y":2395,"width":2250,"height":355},
		{"id":"lane5","type":"group","label":"Contract creation","x":-30,"y":1985,"width":2250,"height":355},
		{"id":"lane4","type":"group","label":"Public booking","x":-30,"y":1575,"width":1800,"height":355},
		{"id":"lane3","type":"group","label":"Property read and mutation","x":-30,"y":1165,"width":1800,"height":355},
		{"id":"lane2","type":"group","label":"Sign-in and authorization","x":-30,"y":755,"width":2250,"height":355},
		{"id":"lane1","type":"group","label":"Organization onboarding","x":-30,"y":345,"width":1800,"height":355},
		{"id":"lane0","type":"group","label":"Platform setup","x":-30,"y":-65,"width":1800,"height":355},
		{"id":"legend","type":"text","text":"## Workflow reading guide\n\nEach horizontal lane is a separate process. These flows summarize inspected source, not completed runtime tests. Orange/red steps identify uncertainty or defects. Other inventoried modules need deeper behavioral tracing.","x":0,"y":-340,"width":700,"height":230,"color":"5"},
		{"id":"w0_0","type":"text","text":"## Open setup\n\n/setup → /api/setup","x":0,"y":0,"width":370,"height":250,"color":"4"},
		{"id":"w0_1","type":"text","text":"## Check root exists\n\nExisting root blocks initialization.","x":450,"y":0,"width":370,"height":250,"color":"4"},
		{"id":"w0_2","type":"text","text":"## Create platform identity\n\nRoot user, role and SaaS settings.","x":900,"y":0,"width":370,"height":250,"color":"4"},
		{"id":"w0_3","type":"text","text":"## Review setup safety\n\nConcurrency and rollback require validation.","x":1350,"y":0,"width":370,"height":250,"color":"2"},
		{"id":"w1_0","type":"text","text":"## Submit organization\n\n/create-organization → /api/public/organizations","x":0,"y":410,"width":370,"height":250,"color":"4"},
		{"id":"w1_1","type":"text","text":"## Validate registration\n\nRequired fields, administrator email duplication, slug and plan.","x":450,"y":410,"width":370,"height":250,"color":"4"},
		{"id":"w1_2","type":"text","text":"## Create tenant\n\nOrganization → default roles → administrator.","x":900,"y":410,"width":370,"height":250,"color":"4"},
		{"id":"w1_3","type":"text","text":"## Review provisioning\n\nSequential failure recovery and default permission semantics need checks.","x":1350,"y":410,"width":370,"height":250,"color":"2"},
		{"id":"w2_0","type":"text","text":"## Credentials\n\nNormalize email; load user, role and organization.","x":0,"y":820,"width":370,"height":250,"color":"4"},
		{"id":"w2_1","type":"text","text":"## Login validation\n\nCompare bcrypt hash; reject inactive user / suspended organization.","x":450,"y":820,"width":370,"height":250,"color":"4"},
		{"id":"w2_2","type":"text","text":"## Issue session\n\nIdentity, role, permissions and organization stored in JWT/session.","x":900,"y":820,"width":370,"height":250,"color":"4"},
		{"id":"w2_3","type":"text","text":"## Route and authorize\n\nMiddleware destination; each API must check action + resource scope.","x":1350,"y":820,"width":370,"height":250,"color":"4"},
		{"id":"w2_4","type":"text","text":"## Revocation gap\n\nTest existing sessions after suspension or role reassignment.","x":1800,"y":820,"width":370,"height":250,"color":"2"},
		{"id":"w3_0","type":"text","text":"## Workspace request\n\n/properties → /api/properties or /api/properties/[id]","x":0,"y":1230,"width":370,"height":250,"color":"4"},
		{"id":"w3_1","type":"text","text":"## Read guards\n\ncheckPermission + propertyViewFilter.","x":450,"y":1230,"width":370,"height":250,"color":"4"},
		{"id":"w3_2","type":"text","text":"## Scoped result\n\nTenant scope; own mode uses createdBy, agent or owner.","x":900,"y":1230,"width":370,"height":250,"color":"4"},
		{"id":"w3_3","type":"text","text":"## Mutation discrepancy\n\nPUT/DELETE authenticate but use unscoped ID mutations.","x":1350,"y":1230,"width":370,"height":250,"color":"1"},
		{"id":"w4_0","type":"text","text":"## Property detail\n\nPublic /property/[id] or /unit/[id]; submitted contact/date.","x":0,"y":1640,"width":370,"height":250,"color":"4"},
		{"id":"w4_1","type":"text","text":"## Validate resources\n\nValidate fields, property and unit relationship.","x":450,"y":1640,"width":370,"height":250,"color":"4"},
		{"id":"w4_2","type":"text","text":"## Associate user\n\nFind email match or create guest. Email submission is not identity proof.","x":900,"y":1640,"width":370,"height":250,"color":"2"},
		{"id":"w4_3","type":"text","text":"## Create booking\n\nOrganization comes from property. Review abuse/identity requirements.","x":1350,"y":1640,"width":370,"height":250,"color":"4"},
		{"id":"w5_0","type":"text","text":"## Submit contract\n\n/api/contracts POST; create permission + authentication.","x":0,"y":2050,"width":370,"height":250,"color":"4"},
		{"id":"w5_1","type":"text","text":"## Resolve property owner\n\nReads property by ID; tenant and unit relationship checks incomplete.","x":450,"y":2050,"width":370,"height":250,"color":"1"},
		{"id":"w5_2","type":"text","text":"## Create contract\n\nInject caller organization; set owner from property.","x":900,"y":2050,"width":370,"height":250,"color":"4"},
		{"id":"w5_3","type":"text","text":"## Update availability\n\nSale → Sold; Rent/Lease → Rented. Unit branch counts available units before property update.","x":1350,"y":2050,"width":370,"height":250,"color":"4"},
		{"id":"w5_4","type":"text","text":"## Partial-write risk\n\nNo enclosing transaction in inspected handler. Define recovery.","x":1800,"y":2050,"width":370,"height":250,"color":"2"},
		{"id":"w6_0","type":"text","text":"## Record payment\n\nClean optional references; resolve tenant timezone.","x":0,"y":2460,"width":370,"height":250,"color":"4"},
		{"id":"w6_1","type":"text","text":"## Create invoice record\n\nGenerate identifier and initial deposit history.","x":450,"y":2460,"width":370,"height":250,"color":"4"},
		{"id":"w6_2","type":"text","text":"## Save payment\n\nInject tenant and processedBy.","x":900,"y":2460,"width":370,"height":250,"color":"4"},
		{"id":"w6_3","type":"text","text":"## Attempt commission\n\nLoad property agent, calculate percentage/fixed commission.","x":1350,"y":2460,"width":370,"height":250,"color":"4"},
		{"id":"w6_4","type":"text","text":"## Reconciliation gap\n\nCommission failure is logged; payment still succeeds. Commission tenant association needs review.","x":1800,"y":2460,"width":370,"height":250,"color":"2"},
		{"id":"w7_0","type":"text","text":"## Edit profile\n\n/profile or /superadmin/profile","x":0,"y":2870,"width":370,"height":250,"color":"4"},
		{"id":"w7_1","type":"text","text":"## Save identity\n\n/api/profile saves account changes.","x":450,"y":2870,"width":370,"height":250,"color":"4"},
		{"id":"w7_2","type":"text","text":"## Refresh session\n\nJWT reloads identity from database; client requests session update.","x":900,"y":2870,"width":370,"height":250,"color":"4"},
		{"id":"w7_3","type":"text","text":"## Header display\n\nHeader should use refreshed session. Regression coverage still required.","x":1350,"y":2870,"width":370,"height":250,"color":"2"},
		{"id":"w8_0","type":"text","text":"## Caller invokes helper\n\nlib/notifications.ts; not every workflow is proven to invoke it.","x":0,"y":3280,"width":370,"height":250,"color":"4"},
		{"id":"w8_1","type":"text","text":"## Resolve configuration\n\nFetch settings over HTTP, then environment fallback.","x":450,"y":3280,"width":370,"height":250,"color":"4"},
		{"id":"w8_2","type":"text","text":"## Prepare provider\n\nSMTP transporter or Twilio client.","x":900,"y":3280,"width":370,"height":250,"color":"4"},
		{"id":"w8_3","type":"text","text":"## Attempt delivery\n\nReturn success or false. No real delivery tested in this mapping.","x":1350,"y":3280,"width":370,"height":250,"color":"2"}
	],
